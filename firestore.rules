rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasAccessToCarteira(carteiraId) {
      return carteiraId != null &&
             (
               get(/databases/$(database)/documents/carteiras/$(carteiraId)).data.get('ownerId', '') == request.auth.uid ||
               (
                 get(/databases/$(database)/documents/carteiras/$(carteiraId)).data.get('emailsCompartilhados', null) != null &&
                 request.auth.token.email in get(/databases/$(database)/documents/carteiras/$(carteiraId)).data.get('emailsCompartilhados', [])
               )
             );
    }

    function hasAccessToDevedor(devedorData) {
      return devedorData.get('ownerId', '') == request.auth.uid || 
             (devedorData.get('carteiraId', null) != null && hasAccessToCarteira(devedorData.get('carteiraId', null)));
    }

    function isValidDevedorShape(data) {
      return data.keys().hasAll(['nomeCompleto', 'taxaJurosMensal', 'saldoDevedorAtual', 'ownerId', 'totalLucroGerado', 'dataCriacao']) &&
             data.nomeCompleto is string && data.nomeCompleto.size() <= 200 &&
             (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 20)) &&
             data.taxaJurosMensal is number && data.taxaJurosMensal >= 0 &&
             data.saldoDevedorAtual is number &&
             data.totalLucroGerado is number &&
             (!('diaVencimento' in data) || (data.diaVencimento is number && data.diaVencimento >= 1 && data.diaVencimento <= 31)) &&
             (!('ultimoPagamento' in data) || (data.ultimoPagamento == null || data.ultimoPagamento is timestamp)) &&
             (!('endereco' in data) || (data.endereco == null || (data.endereco is string && data.endereco.size() <= 500))) &&
             (!('observacoes' in data) || (data.observacoes == null || (data.observacoes is string && data.observacoes.size() <= 1000))) &&
             (!('criadoPorEmail' in data) || data.criadoPorEmail == null || data.criadoPorEmail is string) &&
             (!('criadoPorNome' in data) || data.criadoPorNome == null || data.criadoPorNome is string) &&
             (!('ultimaAlteracaoPorEmail' in data) || data.ultimaAlteracaoPorEmail == null || data.ultimaAlteracaoPorEmail is string) &&
             (!('ultimaAlteracaoPorNome' in data) || data.ultimaAlteracaoPorNome == null || data.ultimaAlteracaoPorNome is string) &&
             (!('ultimaAlteracaoData' in data) || data.ultimaAlteracaoData == null || data.ultimaAlteracaoData is timestamp);
    }

    function isValidHistorico(data) {
      return data.keys().hasAll(['data', 'tipo', 'valorTotal', 'saldoRestante', 'ownerId', 'valorJuros', 'valorAmortizado', 'observacao']) &&
             data.tipo in ['PAGAMENTO', 'APORTE'] &&
             data.valorTotal is number &&
             data.saldoRestante is number &&
             data.valorJuros is number &&
             data.valorAmortizado is number &&
             (data.observacao == null || (data.observacao is string && data.observacao.size() <= 1000)) &&
             (!('criadoPorEmail' in data) || data.criadoPorEmail == null || data.criadoPorEmail is string) &&
             (!('criadoPorNome' in data) || data.criadoPorNome == null || data.criadoPorNome is string) &&
             (!('emprestimoId' in data) || data.emprestimoId == null || data.emprestimoId is string) &&
             data.ownerId == request.auth.uid;
    }

    function isValidEmprestimo(data) {
      return data.keys().hasAll(['valorBruto', 'saldoDevedor', 'taxaJurosMensal', 'diaVencimento', 'dataInicio', 'status', 'ownerId']) &&
             data.valorBruto is number && data.valorBruto >= 0 &&
             data.saldoDevedor is number && data.saldoDevedor >= 0 &&
             data.taxaJurosMensal is number && data.taxaJurosMensal >= 0 &&
             data.diaVencimento is number && data.diaVencimento >= 1 && data.diaVencimento <= 31 &&
             data.status in ['ATIVO', 'QUITADO'] &&
             data.ownerId == request.auth.uid &&
             (!('dataVencimento' in data) || data.dataVencimento == null || data.dataVencimento is timestamp) &&
             (!('ultimoPagamento' in data) || data.ultimoPagamento == null || data.ultimoPagamento is timestamp) &&
             (!('observacao' in data) || data.observacao == null || (data.observacao is string && data.observacao.size() <= 1000)) &&
             (!('origem' in data) || data.origem == null || (data.origem is string && data.origem.size() <= 200)) &&
             (!('totalLucroGerado' in data) || data.totalLucroGerado is number);
    }

    function isValidCarteira(data) {
      return data.keys().hasAll(['nome', 'ownerId', 'dataCriacao']) &&
             data.nome is string && data.nome.size() <= 100 &&
             (!('ownerEmail' in data) || data.ownerEmail == null || data.ownerEmail is string) &&
             (!('emailsCompartilhados' in data) || data.emailsCompartilhados is list);
    }

    match /devedores/{devedorId} {
      allow create: if isSignedIn() && isValidId(devedorId) && 
                      isValidDevedorShape(request.resource.data) &&
                      request.resource.data.ownerId == request.auth.uid &&
                      (request.resource.data.get('carteiraId', null) == null || hasAccessToCarteira(request.resource.data.get('carteiraId', null)));
      
      allow get: if isSignedIn() && hasAccessToDevedor(resource.data);
      allow list: if isSignedIn() && hasAccessToDevedor(resource.data);
      
      allow update: if isSignedIn() &&
                      hasAccessToDevedor(resource.data) &&
                      isValidDevedorShape(request.resource.data) &&
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.dataCriacao == resource.data.dataCriacao &&
                      (request.resource.data.get('carteiraId', null) == null || hasAccessToCarteira(request.resource.data.get('carteiraId', null))) &&
                      (
                        request.resource.data.get('carteiraId', null) == resource.data.get('carteiraId', null) ||
                        (
                          resource.data.get('carteiraId', null) == null ?
                            resource.data.ownerId == request.auth.uid :
                            get(/databases/$(database)/documents/carteiras/$(resource.data.get('carteiraId', ''))).data.ownerId == request.auth.uid
                        )
                      );
      
      allow delete: if isSignedIn() && hasAccessToDevedor(resource.data) &&
                      (
                        resource.data.get('carteiraId', null) == null ? 
                          resource.data.ownerId == request.auth.uid :
                          get(/databases/$(database)/documents/carteiras/$(resource.data.get('carteiraId', ''))).data.ownerId == request.auth.uid
                      );

      match /historico/{transacaoId} {
        allow create: if isSignedIn() && isValidId(transacaoId) &&
                        isValidHistorico(request.resource.data) &&
                        hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data);
        allow get: if isSignedIn() && hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data);
        allow list: if isSignedIn() && hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data);
        allow update: if isSignedIn() &&
                        hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data) &&
                        isValidHistorico(request.resource.data) &&
                        request.resource.data.ownerId == resource.data.ownerId;
      }

      match /emprestimos/{emprestimoId} {
        allow create: if isSignedIn() && isValidId(emprestimoId) &&
                        isValidEmprestimo(request.resource.data) &&
                        hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data);
        allow get: if isSignedIn() && hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data);
        allow list: if isSignedIn() && hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data);
        allow update: if isSignedIn() &&
                        hasAccessToDevedor(get(/databases/$(database)/documents/devedores/$(devedorId)).data) &&
                        isValidEmprestimo(request.resource.data) &&
                        request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isSignedIn() &&
                        get(/databases/$(database)/documents/devedores/$(devedorId)).data.ownerId == request.auth.uid;
      }
    }

    match /carteiras/{carteiraId} {
      allow create: if isSignedIn() && isValidId(carteiraId) && isValidCarteira(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && (resource.data.get('ownerId', '') == request.auth.uid || 
                     (resource.data.get('emailsCompartilhados', null) != null && request.auth.token.email in resource.data.get('emailsCompartilhados', [])));
      allow list: if isSignedIn() && (resource.data.get('ownerId', '') == request.auth.uid || 
                     (resource.data.get('emailsCompartilhados', null) != null && request.auth.token.email in resource.data.get('emailsCompartilhados', [])));
      allow update: if isSignedIn() && 
                      (resource.data.get('ownerId', '') == request.auth.uid || 
                       (resource.data.get('emailsCompartilhados', null) != null && request.auth.token.email in resource.data.get('emailsCompartilhados', []))) &&
                      isValidCarteira(request.resource.data) &&
                      request.resource.data.ownerId == resource.data.ownerId &&
                      request.resource.data.dataCriacao == resource.data.dataCriacao;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /autorizacoes/{autorizacaoId} {
      allow read: if isSignedIn() && (resource == null || resource.data.get('email', '') == request.auth.token.email);
      allow write: if false;
    }
  }
}
